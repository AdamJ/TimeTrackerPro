{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "dist/**",
    "dev-dist/**",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "test-results/**",
    ".superpowers/**",
    ".claude/**",
    "docs/superpowers/**",
    "docs/plans/**",
    "CHANGELOG.md"
  ]
}
