# Cloudflare Pages response headers for the web/PWA build.
# frame-ancestors only works as a header (browsers ignore it in a <meta> CSP),
# so the full policy is repeated here; keep it in sync with index.html.
# HSTS starts at 5 minutes — raise to max-age=31536000 once HTTPS is confirmed
# on every hostname that serves the app.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self' data:; img-src 'self' data: blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=300; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
